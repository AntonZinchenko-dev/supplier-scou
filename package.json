{
  "name": "supplier-scout",
  "private": true,
  "version": "1.0.0",
  "description": "Скаут поставщиков — прототип сервиса поиска и сравнения поставщиков продуктов питания. Демо на моках (MSW), GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
